ROLLBACK;
-- Error: Wrong policy
BEGIN;
CREATE EXTENSION IF NOT EXISTS anon CASCADE;
CREATE ROLE import_anna LOGIN;
SELECT * FROM anon.import_roles_rules(
$$
{
    "import_anna": "MASKED"
}
$$, 'not_a_policy'
);
INFO:  SECURITY LABEL FOR not_a_policy ON ROLE import_anna IS $label_test$ MASKED $label_test$;
ERROR:  security label provider "not_a_policy" is not loaded
CONTEXT:  SQL statement "SECURITY LABEL FOR not_a_policy ON ROLE import_anna IS $label_test$ MASKED $label_test$;"
ROLLBACK;
-- Error: Wrong user name
BEGIN;
CREATE EXTENSION IF NOT EXISTS anon CASCADE;
SELECT * FROM anon.import_roles_rules(
$$
{
    "not_a_user": "MASKED"
}
$$, 'impexp'
);
INFO:  SECURITY LABEL FOR impexp ON ROLE not_a_user IS $label_test$ MASKED $label_test$;
ERROR:  role "not_a_user" does not exist
CONTEXT:  SQL statement "SECURITY LABEL FOR impexp ON ROLE not_a_user IS $label_test$ MASKED $label_test$;"
ROLLBACK;
-- Error: Invalid label syntax
BEGIN;
CREATE EXTENSION IF NOT EXISTS anon CASCADE;
CREATE SCHEMA test;
SELECT * FROM anon.import_database_rules(
$$
{
    "schemas": {
        "test": {
            "mask": "MISTAKE"
        }
    }
}
$$, 'impexp'
);
INFO:  SECURITY LABEL FOR impexp ON SCHEMA test IS $label_test$ MISTAKE $label_test$;
ERROR:  Anon: ` MISTAKE ` is not a valid label for a schema
CONTEXT:  SQL statement "SECURITY LABEL FOR impexp ON SCHEMA test IS $label_test$ MISTAKE $label_test$;"
ROLLBACK;
-- Error: Invalid relkind
BEGIN;
CREATE EXTENSION IF NOT EXISTS anon CASCADE;
CREATE SCHEMA test;
SELECT * FROM anon.import_database_rules(
$$
{
    "schemas": {
        "test": {
           "car": {
                 "v": {
                    "mask": "MASKED WHEN c > 10",
                    "columns": {
                        "t": "MASKED WITH FUNCTION pg_catalog.md5(t)"
                    }
                }
            }
        }
    }
}
$$, 'impexp'
);
ERROR:  Serialization error: Error("unknown field `car`, expected one of `mask`, `functions`, `tables`, `views`, `foreign_tables`", line: 0, column: 0)
ROLLBACK;
