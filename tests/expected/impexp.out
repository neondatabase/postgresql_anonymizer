INFO:  SECURITY LABEL FOR impexp ON COLUMN "test"."t2"."t" IS $label_test$ MASKED WITH VALUE NULL $label_test$;
INFO:  SECURITY LABEL FOR impexp ON VIEW "test"."v" IS $label_test$ MASKED WHEN c > 10 $label_test$;
INFO:  SECURITY LABEL FOR impexp ON COLUMN "test"."v"."t" IS $label_test$ MASKED WITH FUNCTION pg_catalog.md5(t) $label_test$;
