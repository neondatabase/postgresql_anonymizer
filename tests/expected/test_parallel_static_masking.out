DROP TABLE stock;
DROP TABLE employee cascade;
NOTICE:  drop cascades to 2 other objects
DETAIL:  drop cascades to constraint call_history_fk_employee_phone_fkey on table call_history
drop cascades to constraint profile_customer_id_fkey on table profile
DROP TABLE call_history cascade;
DROP TABLE profile cascade;
DROP TABLE "Users";
DROP EXTENSION anon cascade;
